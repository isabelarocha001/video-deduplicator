# Supabase Storage used by the web API (never commit real secrets)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-secret
SUPABASE_STORAGE_BUCKET=vd-media
SUPABASE_STORAGE_PUBLIC=false
SUPABASE_STORAGE_SIGNED_TTL=86400

# Optional Bunny Storage / CDN for the standalone CLI only
# BUNNY_STORAGE_ZONE=privsexv5
# BUNNY_STORAGE_API_KEY=your-storage-password
# BUNNY_STORAGE_HOST=br.storage.bunnycdn.com
# BUNNY_CDN_HOSTNAME=privsexcdnv5.b-cdn.net
# BUNNY_CDN_BASE_URL=https://privsexcdnv5.b-cdn.net

# Optional Stream
# BUNNY_LIBRARY_ID=765672
# BUNNY_STREAM_API_KEY=
# BUNNY_STREAM_CDN_HOSTNAME=vz-xxxx.b-cdn.net

# Rendi.dev FFmpeg cloud (https://www.rendi.dev/docs/introduction)
RENDI_API_KEY=your-rendi-api-key
# FORCE_RENDI=1   # force Rendi even if local ffmpeg exists
