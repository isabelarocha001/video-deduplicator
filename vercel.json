{
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "memory": 1024,
      "includeFiles": "vd/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/process", "destination": "/public/process.html" },
    { "source": "/css/(.*)", "destination": "/public/css/$1" },
    { "source": "/js/(.*)", "destination": "/public/js/$1" },
    { "source": "/", "destination": "/public/index.html" }
  ]
}
